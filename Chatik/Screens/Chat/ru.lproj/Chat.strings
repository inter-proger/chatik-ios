/*
  Chat.strings
  Chatik

  Строки экрана переписки.
*/

"chat.empty" = "Сообщений пока нет";
"chat.input.placeholder" = "Сообщение";
"chat.send" = "Отправить";

/* Подсказка под полем ввода, если текст длиннее лимита сервера; %d — лимит */
"chat.input.too_long" = "Сообщение не должно быть длиннее %d символов";

/* Пометка у отредактированного сообщения рядом со временем */
"chat.message.edited" = "изменено";

