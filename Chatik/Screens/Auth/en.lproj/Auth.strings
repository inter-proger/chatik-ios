/*
  Auth.strings
  Chatik

  Sign up / log in screen strings.
*/

"auth.title.signup" = "Sign Up";
"auth.title.login" = "Log In";

"auth.field.name" = "Name";
"auth.field.login" = "Username";
"auth.field.password" = "Password";

"auth.password.show" = "Show password";
"auth.password.hide" = "Hide password";

"auth.button.signup" = "Sign Up";
"auth.button.login" = "Log In";

/* %1$@ — license agreement URL, %2$@ — privacy policy URL (positional, any order in the text) */
"auth.agreement" = "By signing up, you accept the [License Agreement](%1$@) and [Privacy Policy](%2$@)";

/* %1$@ — internal mode-switch URL, the link must stay in the text */
"auth.switch.to_login" = "Already have an account? **[Log in](%1$@)**";
"auth.switch.to_signup" = "No account? **[Sign up](%1$@)**";

/* Hints shown while a field is focused (sign-up mode) */
"auth.hint.name" = "Letters, digits, space, “-” and “_”";
"auth.hint.login" = "Latin letters, digits and “_”";
"auth.hint.password" = "At least 8 characters, an uppercase and a lowercase Latin letter, a digit";

/* Validation errors (sign-up mode) */
"auth.error.name.empty" = "Enter your name";
"auth.error.name.invalid_characters" = "Only letters, digits, space, “-” and “_” are allowed";
"auth.error.login.empty" = "Enter your username";
"auth.error.login.invalid_characters" = "Only Latin letters, digits and “_” are allowed";
/* %d — maximum length */
"auth.error.name.too_long" = "The name must not be longer than %d characters";
"auth.error.login.too_long" = "The username must not be longer than %d characters";
"auth.error.password.too_short" = "Password must be at least 8 characters";
"auth.error.password.missing_uppercase" = "Add at least one uppercase Latin letter";
"auth.error.password.missing_lowercase" = "Add at least one lowercase Latin letter";
"auth.error.password.missing_digit" = "Add at least one digit";

/* Language menu */
"auth.language" = "Language";
