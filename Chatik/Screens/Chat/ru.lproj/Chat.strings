/* Состояние сообщения, отправка которого не удалась */
"chat.message.failed" = "Не отправлено";

/* Заголовок выбора действия по тапу на неотправленное сообщение */
"chat.failed_actions.title" = "Сообщение не отправлено";
"chat.failed_actions.retry" = "Повторить отправку";
"chat.failed_actions.delete" = "Удалить сообщение";

/* Подпись под заголовком, пока переписка синхронизируется с сервером */
"chat.updating" = "Обновление…";
