/* Заголовок листа; %d — сколько участников прочитали сообщение */
"message_readers.title" = "Прочитано: %d";

/* Заголовок листа, пока список прочитавших загружается или не загрузился */
"message_readers.title_unknown" = "Кем прочитано";

/* Лист открыт, но сообщение ещё никто не прочитал */
"message_readers.empty" = "Пока никто не прочитал";

/* Список прочитавших не загрузился: данных нет ни на устройстве, ни с сервера */
"message_readers.failed" = "Не удалось загрузить, кто прочитал";
