/*
  Chat.strings
  Chatik

  Conversation screen strings.
*/

"chat.empty" = "No messages yet";
"chat.input.placeholder" = "Message";
"chat.send" = "Send";

/* Hint below the input when the text exceeds the server limit; %d is the limit */
"chat.input.too_long" = "Message must be at most %d characters";

/* Mark next to the time of an edited message */
"chat.message.edited" = "Edited";

/* Text shown instead of a message whose type the app cannot display yet */
"chat.message.unsupported" = "Unsupported message";

/* Title when a conversation has neither a name nor an opponent */
"chat.title.untitled" = "Untitled";

/* Opponent or sender name while the user is not loaded yet; shown redacted as a placeholder */
"chat.user.loading" = "Loading…";

/* Opponent or sender name when the user no longer exists on the server */
"chat.user.deleted" = "Deleted user";

/* Message state while the server has not confirmed sending (for VoiceOver) */
"chat.message.sending" = "Sending";

/* State of a message that failed to send */
"chat.message.failed" = "Not sent";

/* Title of the action choice shown on tapping an unsent message */
"chat.failed_actions.title" = "Message not sent";
"chat.failed_actions.retry" = "Retry sending";
"chat.failed_actions.delete" = "Delete message";

/* Subtitle under the title while the conversation syncs with the server */
"chat.updating" = "Updating…";

/* Action in the long-press menu of an own message */
"chat.message_actions.edit" = "Edit";

/* Title of the banner above the input field in editing mode */
"chat.edit.title" = "Editing";

/* Close button of the editing banner (VoiceOver) */
"chat.edit.cancel" = "Cancel editing";

/* Confirm button that replaces "Send" while editing (VoiceOver) */
"chat.edit.save" = "Save";
